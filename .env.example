# Application Configuration
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me-to-a-long-random-string

# Channels – e-mail (SMTP)
# Locally: Mailpit (`mailpit`, inbox at http://localhost:8025)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM=GS Alerting <alerts@gs-alerting.local>

# Production / Gmail setup:
# UWAGA: Google nie pozwala na używanie zwykłego hasła do konta (np. Admin123) w SMTP!
# Wymagane jest Hasło do Aplikacji (16 znaków):
# 1. Włącz Weryfikację Dwuetapową na koncie Google (np. DemoGS@gmail.com)
# 2. Wygeneruj Hasło do Aplikacji: https://myaccount.google.com/apppasswords (nazwa np. "GS Alerting")
# 3. Wklej 16-znakowe hasło poniżej:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=DemoGS@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# MAIL_FROM=GS Alerting <DemoGS@gmail.com>
# Base URL used for "Open alert" links in e-mails and SMS
APP_URL=http://localhost:5173
